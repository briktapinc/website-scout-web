NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com
SESSION_SECRET=change-me-to-a-long-random-string

# mysql (Hostinger / Docker) or sqlite (local without Docker)
DB_DRIVER=mysql

# Local-only SQLite file when DB_DRIVER=sqlite
# SQLITE_PATH=./data/website-scout-web.sqlite

# Hostinger MySQL (or local Docker) when DB_DRIVER=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=scout
MYSQL_PASSWORD=scout
MYSQL_DATABASE=website_scout

# Optional: create first owner on migrate if no users exist
# BOOTSTRAP_EMAIL=owner@example.com
# BOOTSTRAP_PASSWORD=change-me
# BOOTSTRAP_WORKSPACE=My Workspace
# Bootstrap user is promoted to platform super admin by default (set 0 to skip)
# BOOTSTRAP_SUPER_ADMIN=1
